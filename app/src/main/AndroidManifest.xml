<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">

        <!-- Google Maps API Key injected from .env via secrets-gradle-plugin -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />
        <!-- 1. Standalone Customer / Shopper App -->
        <activity
            android:name=".CustomerAppActivity"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="OmniCart Shopper"
            android:taskAffinity="com.omnicart.shopper"
            android:theme="@style/Theme.MyApplication">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:theme="@style/Theme.MyApplication" />

        <!-- 2. Standalone Merchant / Darkstore Partner App -->
        <activity
            android:name=".PartnerAppActivity"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_partner"
            android:roundIcon="@mipmap/ic_launcher_partner_round"
            android:label="OmniCart Partner"
            android:taskAffinity="com.omnicart.partner"
            android:theme="@style/Theme.MyApplication">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 3. Standalone Rider / Delivery Fleet App -->
        <activity
            android:name=".RiderAppActivity"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_rider"
            android:roundIcon="@mipmap/ic_launcher_rider_round"
            android:label="OmniCart Rider"
            android:taskAffinity="com.omnicart.rider"
            android:theme="@style/Theme.MyApplication">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
